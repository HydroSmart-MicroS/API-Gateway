{
    email {$TLS_EMAIL}
    admin off
}
{$API_DOMAIN} {
    redir /status /status/ 308
    @config_panel path /status/ /status/services /status/dashboard.css /status/dashboard.js
    handle @config_panel {
        header Cache-Control no-store
        basic_auth bcrypt "HydroSmart Estado" {
            monitor {$STATUS_PASSWORD_HASH}
        }
        reverse_proxy config-service:8080 {
            header_up -Authorization
        }
    }
    import /etc/caddy/routes.caddy
}
# Publicar 80/443, persistir /data y usar DNS real.
# Alinear BETTER_AUTH_URL y JWT_ISSUER con https://API_DOMAIN.
# Deja ENABLE_STATUS_DASHBOARD=false y configura STATUS_PASSWORD_HASH con bcrypt.
